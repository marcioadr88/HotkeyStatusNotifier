<Window x:Class="HotkeyStatusNotifier.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HotkeyStatusNotifier"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border x:Name="Root"
            Background="#CC1F1F1F"
            CornerRadius="10"
            Padding="16,8"
            Opacity="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="IconText" FontSize="24" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StateText" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
